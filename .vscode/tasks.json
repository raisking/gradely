{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start API",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/gradely-api"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "gradely"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/learnquest"
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "gradely"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Gradely (API + Frontend)",
      "dependsOn": ["Start API", "Start Frontend"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install all dependencies",
      "type": "shell",
      "command": "cd learnquest && npm install && cd ../gradely-api && npm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "DB: Run Prisma migrations",
      "type": "shell",
      "command": "npx prisma migrate dev",
      "options": {
        "cwd": "${workspaceFolder}/gradely-api"
      },
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "DB: Seed data",
      "type": "shell",
      "command": "npm run db:seed",
      "options": {
        "cwd": "${workspaceFolder}/gradely-api"
      },
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "DB: Open Prisma Studio",
      "type": "shell",
      "command": "npx prisma studio",
      "options": {
        "cwd": "${workspaceFolder}/gradely-api"
      },
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": []
    }
  ]
}
